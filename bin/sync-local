#!/usr/bin/env bash
# Аналог bin/sync без ruby и AWS SDK: выкачивает actions/runner-images по
# upstream.lock.yml и накладывает патчи bin/patch/<dist>-<arch>.
#
#   bin/sync-local --image-id ubuntu24-full-x64
#
# Результат — releases/<dist>/<arch> (генерируемое дерево, в git не идёт).
set -euo pipefail

image_id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --image-id) image_id="$2"; shift 2 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "неизвестный аргумент: $1" >&2; exit 1 ;;
  esac
done
[ -n "$image_id" ] || { echo "нужен --image-id" >&2; exit 1; }

cd "$(dirname "$0")/.."
for tool in git yq perl; do
  command -v "$tool" >/dev/null || { echo "нужен $tool" >&2; exit 1; }
done

repository=$(yq -r '.repository' upstream.lock.yml)
revision=$(yq -r '.revision' upstream.lock.yml)
[[ "$revision" =~ ^[0-9a-f]{40}$ ]] || { echo "плохая ревизия в upstream.lock.yml: $revision" >&2; exit 1; }

IFS=- read -r dist variant arch <<<"$image_id"
[ -n "$dist" ] && [ -n "$variant" ] && [ -n "$arch" ] || { echo "image id вида <dist>-<variant>-<arch>: $image_id" >&2; exit 1; }
release_dir="releases/$dist/$arch"

workspace=$(mktemp -d)
trap 'rm -rf "$workspace"' EXIT
echo "upstream $repository@$revision"
git init -q "$workspace/repo"
git -C "$workspace/repo" remote add origin "$repository"
git -C "$workspace/repo" fetch -q --depth 1 origin "$revision"
git -C "$workspace/repo" checkout -q --detach FETCH_HEAD

rm -rf "$release_dir"
mkdir -p "$release_dir"
cp -r "$workspace/repo/." "$release_dir/"
for useless in .git .github docs .vscode images.CI .gitignore .gitattributes CODE_OF_CONDUCT.md CONTRIBUTING.md SECURITY.md; do
  rm -rf "$release_dir/$useless"
done
family=${dist//[0-9]/}
for os_dir in images/macos images/windows images/ubuntu; do
  [[ "$os_dir" == *"$family"* ]] || rm -rf "$release_dir/$os_dir"
done

IMAGE_ID="$image_id" "./bin/patch/$dist-$arch" "$release_dir"
echo "OK: $release_dir"
